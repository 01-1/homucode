{
  "extends": ["expo/tsconfig.base.json", "../../tsconfig.effect.json"],
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        // Severities deep-merge with tsconfig.effect.json; React Native has no Effect platform layer.
        "diagnosticSeverity": {
          "globalDate": "off",
          "globalConsole": "off",
          "globalRandom": "off",
          "globalTimers": "off",
          "globalFetch": "off"
        },
        "overrides": [
          {
            "include": [
              "scripts/*.ts",
              "scripts/*.mts",
              "fingerprint.config.js",
              "**/*.test.ts",
              "**/*.test.tsx",
              "**/*.test-support.ts"
            ],
            "options": { "diagnosticSeverity": { "nodeBuiltinImport": "off" } }
          }
        ]
      }
    ],
    // React Native libraries import react without depending on @types/react. In pnpm's
    // global virtual store they cannot reach a hoisted copy, so point them at ours.
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    },
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  }
}
